# Copie para .env.local (teste no notebook) e cadastre as mesmas variáveis na Vercel.
# Nenhum valor real vai para o Git.

# Token que o ESP32 manda em "Authorization: Bearer ...". O mesmo valor vai no segredos.h.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# PIN para corrigir a contagem pelo painel.
ADMIN_PIN=

# Upstash Redis. A integração do Marketplace da Vercel cria estas duas sozinha.
# Sem elas, a API usa memória (só para teste local: os dados somem ao reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (também aceita UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN)
