# Copie para .env.local (painel rodando no notebook). Se um dia publicar na Vercel,
# cadastre as mesmas variáveis lá.
# Nenhum valor real vai para o Git.

# Token que o ESP32 manda em "Authorization: Bearer ...". O mesmo valor vai no segredos.h.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# PIN para corrigir a contagem pelo painel.
ADMIN_PIN=

# Opcional, só para publicar na nuvem: Upstash Redis (a integração da Vercel cria estas duas).
# Sem elas, no notebook os dados ficam em web/.dados/estacionamento.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (também aceita UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN)
